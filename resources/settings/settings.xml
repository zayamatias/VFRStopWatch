<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!-- ── GPS Mode ─────────────────────────────────────────────── -->
    <setting propertyKey="@Properties.GpsMode" title="@Strings.SettingGpsModeTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.SettingGpsModeGps</listEntry>
            <listEntry value="1">@Strings.SettingGpsModeGpsGlonass</listEntry>
            <listEntry value="2">@Strings.SettingGpsModeAllSat</listEntry>
            <listEntry value="3">@Strings.SettingGpsModeAviation</listEntry>
        </settingConfig>
    </setting>

    <!-- ── Timer Interval ────────────────────────────────────────── -->
    <setting propertyKey="@Properties.TimerInterval" title="@Strings.SettingTimerTitle">
        <settingConfig type="numeric" min="0" max="30"/>
    </setting>

    <!-- ── Takeoff Speed ─────────────────────────────────────────── -->
    <setting propertyKey="@Properties.TakeoffSpeed" title="@Strings.SettingTakeoffTitle">
        <settingConfig type="numeric" min="0" max="100"/>
    </setting>

    <!-- Transition Altitude -->
    <setting propertyKey="@Properties.TransitionAltitudeFt" title="@Strings.SettingTransitionTitle">
        <settingConfig type="numeric" min="0" max="20000"/>
    </setting>

    <!-- Heart-Rate Alert -->
    <setting propertyKey="@Properties.HrThreshold" title="@Strings.SettingHrTitle">
        <settingConfig type="numeric" min="0" max="220"/>
    </setting>

    <!-- Fuel Check Interval -->
    <setting propertyKey="@Properties.FuelCheckInterval" title="@Strings.SettingFuelTitle">
        <settingConfig type="numeric" min="0" max="120"/>
    </setting>

    <!-- ── Companion App Toggle ───────────────────────────────────── -->
    <setting propertyKey="@Properties.UseCompanionApp" title="Use Companion App">
        <settingConfig type="list">
            <listEntry value="0">No</listEntry>
            <listEntry value="1">Yes</listEntry>
        </settingConfig>
    </setting>

    <!-- ── Altitude Source ──────────────────────────────────────── -->
    <setting propertyKey="@Properties.AltitudeSource" title="@Strings.SettingAltitudeSourceTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.SettingAltitudeSourceBaro</listEntry>
            <listEntry value="1">@Strings.SettingAltitudeSourceGps</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.CircuitPractice" title="@Strings.SettingCircuitTitle">
        <settingConfig type="list">
            <listEntry value="0">Off</listEntry>
            <listEntry value="1">On</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.FieldElevationFt" title="@Strings.SettingFieldElevTitle">
        <settingConfig type="numeric" min="0" max="20000"/>
    </setting>

    <setting propertyKey="@Properties.RunwayLengthM" title="@Strings.SettingRunwayTitle">
        <settingConfig type="numeric" min="0" max="10000"/>
    </setting>

    <setting propertyKey="@Properties.AltitudeAlertFt" title="@Strings.SettingAltAlertTitle">
        <settingConfig type="numeric" min="0" max="30000"/>
    </setting>

    <setting propertyKey="@Properties.BezelFontScale" title="@Strings.SettingBezelFontScaleTitle">
        <settingConfig type="numeric" min="70" max="130"/>
    </setting>

    <setting propertyKey="@Properties.BezelContrast" title="@Strings.SettingBezelContrastTitle">
        <settingConfig type="numeric" min="50" max="100"/>
    </setting>

    <!-- ── Auto Backlight ─────────────────────────────────────── -->
    <setting propertyKey="@Properties.AutoBacklight" title="Auto Backlight">
        <settingConfig type="list">
            <listEntry value="0">Off</listEntry>
            <listEntry value="1">Always</listEntry>
            <listEntry value="2">Night-only</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.NightStartHour" title="Night Start (h)">
        <settingConfig type="numeric" min="0" max="23"/>
    </setting>

    <setting propertyKey="@Properties.NightEndHour" title="Night End (h)">
        <settingConfig type="numeric" min="0" max="23"/>
    </setting>

    <!-- ── Display layout ─────────────────────────────────────── -->
    <setting propertyKey="@Properties.DisplayMode" title="@Strings.SettingDisplayTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.SettingDisplayRing</listEntry>
            <listEntry value="1">@Strings.SettingDisplayBig</listEntry>
        </settingConfig>
    </setting>

    <!-- Auto page cycle: 0 = off (pages change only when you press UP/DOWN) -->
    <setting propertyKey="@Properties.PageCycleSec" title="@Strings.SettingPageCycleTitle">
        <settingConfig type="numeric" min="0" max="60"/>
    </setting>

</settings>
