<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- 0=GPS only  1=GPS+GLONASS  2=All constellations  3=Aviation (default) -->
    <property id="GpsMode" type="number">3</property>

    <!-- Timer alert interval in minutes (0 = disabled).  Default 5 min. -->
    <property id="TimerInterval" type="number">5</property>

    <!-- Auto-start speed threshold in knots (0 = disabled).  Default 30 kts. -->
    <property id="TakeoffSpeed" type="number">30</property>

    <!-- Transition altitude for FL display in feet. Default 6000 ft. -->
    <property id="TransitionAltitudeFt" type="number">6000</property>

    <!-- Heart-rate alert threshold in bpm (0 = disabled). Default 130 bpm. -->
    <property id="HrThreshold" type="number">130</property>

    <!-- Fuel reminder interval in minutes (0 = disabled). Default 30 min. -->
    <property id="FuelCheckInterval" type="number">30</property>
    
    <!-- Use companion app (0 = disabled, 1 = enabled). Default: disabled -->
    <property id="UseCompanionApp" type="number">0</property>

    <!-- Altitude source: 0=Barometric (default)  1=GPS -->
    <property id="AltitudeSource" type="number">0</property>

    <!-- Circuit practice: 0=off, 1=on. Field elevation 0=auto. -->
    <property id="CircuitPractice" type="number">0</property>
    <property id="FieldElevationFt" type="number">0</property>
    <property id="RunwayLengthM" type="number">2405</property>
    <property id="AltitudeAlertFt" type="number">0</property>

    <!-- Bezel rendering controls. Offsets are pixels relative to the text radius. -->
    <property id="BezelFontScale" type="number">100</property>
    <property id="BezelContrast" type="number">100</property>

    <!-- Auto backlight: 0=off (default), 1=always while flying, 2=night-only -->
    <property id="AutoBacklight" type="number">0</property>
    <!-- Night-only window (hours, 0-23). Default 20:00-07:00. -->
    <property id="NightStartHour" type="number">20</property>
    <property id="NightEndHour" type="number">7</property>

    <!-- Display layout: 0 = bezel ring with four fields (default),
         1 = "big fields": the timer plus one large value, cycled with a short
         DOWN press. Aimed at legibility on the small round screen. -->
    <property id="DisplayMode" type="number">1</property>
    <!-- Seconds per page on the paged face; 0 = manual only (UP/DOWN presses) -->
    <property id="PageCycleSec" type="number">0</property>
</properties>
